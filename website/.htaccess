# CORTEX - cortexrealityfilter.com
Options -Indexes
DirectoryIndex index.html

# Własna strona błędu 404 (ścieżki absolutne, działa na każdym poziomie URL)
ErrorDocument 404 /html/404.html

# Stare adresy podstron (dawne duplikaty w katalogu głównym)
Redirect 301 /contact.html https://cortexrealityfilter.com/html/contact.html
Redirect 301 /privacy.html https://cortexrealityfilter.com/html/privacy.html
Redirect 301 /terms.html https://cortexrealityfilter.com/html/terms.html
Redirect 301 /404.html https://cortexrealityfilter.com/html/404.html

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
